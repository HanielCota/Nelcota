{
  "extends": [
    "../../../.oxlintrc.json"
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "rules": {
    "eslint/complexity": [
      "error",
      10
    ],
    "eslint/max-lines-per-function": [
      "error",
      60
    ],
    "eslint/max-params": [
      "error",
      4
    ]
  }
}
