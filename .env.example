# Copie para .env (que está no .gitignore) e troque os segredos.
# Gere valores com: openssl rand -base64 48

# Senha do superusuário do Postgres de desenvolvimento (docker-compose.yml).
POSTGRES_PASSWORD=postgres

# Conexão administrativa: usada só para migrações e para definir a senha do
# `authenticator`. A API conecta no mesmo host/banco como `authenticator`.
NELCOTA_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
NELCOTA_AUTHENTICATOR_PASSWORD=troque-esta-senha-do-authenticator
# Chave Ed25519 (PKCS#8) que assina os JWTs; a pública vai para o JWKS.
# Gere com:  openssl genpkey -algorithm ed25519 | grep -v -- ----- | tr -d '
'
NELCOTA_JWT_PRIVATE_KEY=
# Alternativa simples/legada: segredo HS256 (>= 32 caracteres).
NELCOTA_JWT_SECRET=troque-este-segredo-de-jwt-com-32-caracteres-ou-mais
NELCOTA_JWT_EXPIRY_SECS=900
NELCOTA_REFRESH_TOKEN_TTL_DAYS=30
NELCOTA_SIGNUP_ENABLED=true
NELCOTA_AUTH_RATE_LIMIT_PER_MINUTE=30
# Recuperação de senha por email (opcional; os três juntos ou nenhum).
# SMTP do provedor: smtps://usuario:senha@host:465 ou smtp://...:587?tls=required
NELCOTA_SMTP_URL=
# Remetente: Loja <nao-responda@loja.com>
NELCOTA_SMTP_FROM=
# Página do seu app que recebe o link (o token vai em #type=recovery&token=...).
NELCOTA_PASSWORD_RECOVERY_URL=
# true só atrás de um proxy (Caddy) que define X-Forwarded-For.
NELCOTA_TRUST_PROXY=false

NELCOTA_LISTEN=127.0.0.1:8000
NELCOTA_DB_POOL_SIZE=10
NELCOTA_REQUEST_TIMEOUT_SECS=15
# text | json
NELCOTA_LOG_FORMAT=text
RUST_LOG=info,tower_http=info
